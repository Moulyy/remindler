// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String           @id
  email       String           @unique
  displayName String           @map("display_name")
  createdAt   DateTime         @map("created_at")
  credentials UserCredentials?
  houses      House[]          @relation("HouseCreator")
  memberships HouseMember[]
  sessions    UserSession[]
  tasks       HouseTask[]      @relation("HouseTaskCreator")

  @@map("users")
}

model UserCredentials {
  userId       String   @id @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model UserSession {
  id                String    @id
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash")
  createdAt         DateTime  @map("created_at")
  lastUsedAt        DateTime  @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model House {
  id        String        @id
  name      String
  createdBy String        @map("created_by")
  createdAt DateTime      @map("created_at")
  creator   User          @relation("HouseCreator", fields: [createdBy], references: [id])
  members   HouseMember[]
  tasks     HouseTask[]

  @@map("houses")
}

model HouseMember {
  id       String          @id
  houseId  String          @map("house_id")
  userId   String          @map("user_id")
  role     HouseMemberRole
  joinedAt DateTime        @map("joined_at")
  house    House           @relation(fields: [houseId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([houseId, userId])
  @@map("house_members")
}

model HouseTask {
  id                  String                        @id
  houseId             String                        @map("house_id")
  title               String
  description         String?
  status              HouseTaskStatus
  priority            HouseTaskPriority
  category            HouseTaskCategory
  assigneeIds         String[]                      @map("assignee_ids")
  dueDate             DateTime?                     @map("due_date")
  recurrenceFrequency HouseTaskRecurrenceFrequency? @map("recurrence_frequency")
  recurrenceInterval  Int?                          @map("recurrence_interval")
  createdBy           String                        @map("created_by")
  createdAt           DateTime                      @map("created_at")
  updatedAt           DateTime                      @map("updated_at")
  completedAt         DateTime?                     @map("completed_at")
  house               House                         @relation(fields: [houseId], references: [id], onDelete: Cascade)
  creator             User                          @relation("HouseTaskCreator", fields: [createdBy], references: [id])

  @@map("house_tasks")
}

enum HouseMemberRole {
  owner
  admin
  member
}

enum HouseTaskStatus {
  todo
  in_progress
  done
  cancelled
  blocked
}

enum HouseTaskPriority {
  low
  medium
  high
}

enum HouseTaskCategory {
  cleaning
  shopping
  admin
  pet
  health
  maintenance
  cooking
  finance
  other
}

enum HouseTaskRecurrenceFrequency {
  none
  daily
  weekly
  monthly
}
